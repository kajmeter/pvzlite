{
  "name": "pvzlite",
  "productName": "pvzlite",
  "version": "1.0.0",
  "description": "pvzlite - Shapers vs Lancers: a 3D survival RTS built with three.js. Mine crystals, wall yourself in, build turrets and level up while Hunters upgrade their blades to break in. Play in the browser, on desktop, or host your own multiplayer server.",
  "type": "module",
  "main": "desktop/main.cjs",
  "homepage": "https://github.com/kajmeter/pvzlite",
  "repository": {
    "type": "git",
    "url": "https://github.com/kajmeter/pvzlite.git"
  },
  "author": {
    "name": "kajmeter",
    "email": "kajetankarp@gmail.com"
  },
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "desktop": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux deb AppImage --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:server": "npm run build && node scripts/build-server-bin.mjs",
    "dist:web": "npm run build && node scripts/build-web-zip.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "three": "^0.170.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "io.github.kajmeter.pvzlite",
    "productName": "pvzlite",
    "copyright": "Copyright (c) 2026 kajmeter. Licensed under Apache-2.0.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "server/**/*",
      "src/shared/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "artifactName": "pvzlite-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "pvzlite",
      "artifactName": "pvzlite-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "pvzlite-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icons",
      "executableName": "pvzlite",
      "maintainer": "kajmeter <kajetankarp@gmail.com>",
      "vendor": "kajmeter",
      "synopsis": "Shapers vs Lancers - 3D survival RTS",
      "description": "pvzlite is a 3D survival RTS: Shapers mine crystal fields, wall themselves in, build turrets and level up to 11 while Lancer Hunters upgrade their blades and armor to break in. Play against AI or friends over LAN/Internet.",
      "desktop": {
        "entry": {
          "Name": "pvzlite",
          "Comment": "Shapers vs Lancers survival RTS",
          "Categories": "Game;StrategyGame;",
          "StartupWMClass": "pvzlite"
        }
      }
    },
    "deb": {
      "artifactName": "pvzlite_${version}_amd64.${ext}"
    },
    "appImage": {
      "artifactName": "pvzlite-${version}-x86_64.${ext}"
    },
    "publish": null
  },
  "desktopName": "pvzlite.desktop"
}
