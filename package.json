{
  "name": "shardfall",
  "productName": "Shardfall",
  "version": "1.0.0",
  "description": "Shardfall - a fast, lightweight 3D real-time strategy game (worker economy + shielded melee warriors) built with three.js. Play in the browser, on desktop, or host your own multiplayer server.",
  "type": "module",
  "main": "desktop/main.cjs",
  "homepage": "https://github.com/kajmeter/pvzlite",
  "repository": {
    "type": "git",
    "url": "https://github.com/kajmeter/pvzlite.git"
  },
  "author": {
    "name": "kajmeter",
    "email": "kajetankarp@gmail.com"
  },
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "node scripts/check-syntax.mjs",
    "desktop": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux deb AppImage --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:server": "npm run build && node scripts/build-server-bin.mjs",
    "dist:web": "npm run build && node scripts/build-web-zip.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "three": "^0.170.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "io.github.kajmeter.shardfall",
    "productName": "Shardfall",
    "copyright": "Copyright (c) 2026 kajmeter. Licensed under Apache-2.0.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "server/**/*",
      "src/shared/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "artifactName": "Shardfall-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shardfall",
      "artifactName": "Shardfall-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Shardfall-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icons",
      "executableName": "shardfall",
      "maintainer": "kajmeter <kajetankarp@gmail.com>",
      "vendor": "kajmeter",
      "synopsis": "3D real-time strategy game built with three.js",
      "description": "Shardfall is a fast 3D real-time strategy game: harvest crystals with Shaper drones, build a crystal citadel and command Lancer knights against AI or friends over LAN/Internet.",
      "desktop": {
        "entry": {
          "Name": "Shardfall",
          "Comment": "3D real-time strategy game",
          "Categories": "Game;StrategyGame;",
          "StartupWMClass": "Shardfall"
        }
      }
    },
    "deb": {
      "artifactName": "shardfall_${version}_amd64.${ext}"
    },
    "appImage": {
      "artifactName": "Shardfall-${version}-x86_64.${ext}"
    },
    "publish": null
  },
  "desktopName": "shardfall.desktop"
}
