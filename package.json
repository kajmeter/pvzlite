{
  "name": "shardfall",
  "productName": "Shardfall",
  "version": "1.0.0",
  "description": "Shardfall - a fast, lightweight 3D real-time strategy game (worker economy + shielded melee warriors) built with three.js. Play in the browser, on desktop, or host your own multiplayer server.",
  "type": "module",
  "main": "desktop/main.cjs",
  "homepage": "https://github.com/kajmeter/pvzlite",
  "repository": {
    "type": "git",
    "url": "https://github.com/kajmeter/pvzlite.git"
  },
  "author": {
    "name": "kajmeter",
    "email": "kajetankarp@gmail.com"
  },
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "node scripts/check-syntax.mjs",
    "desktop": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux deb AppImage --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:server": "npm run build && node scripts/build-server-bin.mjs",
    "dist:web": "npm run build && node scripts/build-web-zip.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "three": "^0.170.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
